# ===== OBLIGATORIO =====
ANTHROPIC_API_KEY=sk-ant-...

# ===== Personal =====
OWNER_NAME=Tu nombre
TIMEZONE=Europe/Madrid
BRIEF_TIME=08:00            # resumen diario por WhatsApp
INBOX_CHECK_MINUTES=30      # cada cuánto vigila el correo (0 = nunca)
ALLOW_SEND_EMAIL=false      # false = Jarvis solo crea borradores
# JARVIS_EFFORT=medium      # low | medium | high

# ===== Gmail + Calendar =====
# Pon credentials.json (OAuth "Desktop app") en esta carpeta y ejecuta: python -m jarvis.setup_google
GOOGLE_CALENDAR_ID=primary

# ===== Notion =====
NOTION_TOKEN=ntn_...
NOTION_TASKS_DB_ID=
NOTION_TITLE_PROPERTY=Name
NOTION_STATUS_PROPERTY=     # opcional: nombre de la propiedad Estado/Checkbox

# ===== WhatsApp (Twilio) =====
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP=whatsapp:+34600000000
PUBLIC_BASE_URL=https://tu-dominio-o-ngrok.app

# ===== Chat web =====
JARVIS_WEB_TOKEN=pon-una-contraseña-larga
